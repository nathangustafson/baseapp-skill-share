{
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/db-backup-staleness.sh" }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-docker.sh" }
      ] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/auto-status-report.sh" },
        { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pm-coverage-gate.sh" }
      ] }
    ]
  }
}
